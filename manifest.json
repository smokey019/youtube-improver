{
  "manifest_version": 3,
  "name": "YouTube Improver",
  "version": "0.1.0",
  "description": "Customize YouTube's Home and Subscriptions pages, control default video/Shorts quality and playback speed, tame autoplay, and more.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/index.ts"]
    }
  ],
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "YouTube Improver – open settings"
  }
}
